#!/bin/sh
# wq — WorldQuant.app 内置的命令行入口：用 app 自带的 Python 运行 app 自带的引擎，
# 不需要系统 Python、pip 或源码。可以直接调用，也可以软链到 PATH（软链会被正确解析）。
set -eu
SELF="$0"
while [ -L "$SELF" ]; do
    LINK="$(readlink "$SELF")"
    case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
done
RES="$(cd "$(dirname "$SELF")/.." && pwd -P)"
if [ "$(uname -m)" = arm64 ] || [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = 1 ]; then
    ARCH=arm64
else
    ARCH=x86_64
fi
if [ -x "$RES/runtime/$ARCH/bin/python3" ]; then
    PY="$RES/runtime/$ARCH/bin/python3"
elif [ -x "$HOME/Library/Application Support/WorldQuant/venv/bin/python" ]; then
    PY="$HOME/Library/Application Support/WorldQuant/venv/bin/python"
else
    echo "轻量包没有内置 Python。请先打开菜单完成首次设置（需要本机 Python 3.11+），或改用完整包。" >&2
    echo "This light build has no bundled Python. Open the menu once to finish setup (Python 3.11+ required), or use the full build." >&2
    exit 1
fi
PYTHONDONTWRITEBYTECODE=1 exec "$PY" -m wq "$@"
