{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoWQ workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "routes",
    "stages",
    "combinations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research",
        "review",
        "engineering"
      ],
      "properties": {
        "research": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "engineering": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "enabled",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "research"
            },
            "enabled": {
              "const": true
            },
            "prompt": {
              "type": "string",
              "maxLength": 20000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "enabled",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "review"
            },
            "enabled": {
              "const": true
            },
            "prompt": {
              "type": "string",
              "maxLength": 20000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "enabled",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "simulate"
            },
            "enabled": {
              "type": "boolean"
            },
            "prompt": {
              "const": ""
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "enabled",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "feedback"
            },
            "enabled": {
              "type": "boolean"
            },
            "prompt": {
              "const": ""
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "enabled",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "pre_submit"
            },
            "enabled": {
              "const": true
            },
            "prompt": {
              "const": ""
            }
          }
        }
      ]
    },
    "combinations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "max_plans"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_plans": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    }
  }
}
